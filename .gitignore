## Unity Gitignore
# Official Unity .gitignore adapted for common projects

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Visual Studio / Rider / VSCode
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.slnx

# Unity generated folders
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/MemoryCaptures/
/Recordings/
/LocalCache/

# Asset pipeline
/Assets/AddressableAssetsData/*/*.bin*
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/*

# Asset Store tools
/Assets/AssetStoreTools*

# Packed samples and packages
*.unitypackage

# Builds
*.apk
*.aab
*.exe
*.app

# Audio / video cache
*.weba

# Cache and logs
*.log
*.cache

# Test results
/TestResults/
coverage/

# Secrets and keys
.env
.env.*
*.pem
*.p12
*.key

# Git LFS metadata - keep pointer files in repo (actual binary tracked via LFS)
*.psd
!*.png
*.jpg
*.jpeg
*.tga
*.gif
*.mp4
*.mov
*.mp3
*.wav
*.ogg
*.fbx

# Cleanup
bfg.jar
Portfolio-Game-1.slnx
